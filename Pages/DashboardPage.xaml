<Page x:Class="FikaHeadlessManager.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="无头主机总览"
      Loaded="DashboardPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="28,22,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="运行概览" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="在一个窗口中监控并控制所有无头实例。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="LastUpdatedText" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="添加Headless"
                           Icon="{ui:SymbolIcon Symbol=Add24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Click="AddManager_Click"/>
                <ui:Button Content="全部启动"
                           Icon="{ui:SymbolIcon Symbol=Play24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="StartAll_Click"/>
                <ui:Button Content="全部停止"
                           Icon="{ui:SymbolIcon Symbol=Stop24}"
                           Appearance="Secondary"
                           Click="StopAll_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,18,28,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FluentCardStyle}" MinHeight="128" Margin="0,0,8,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="无头主机数量"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding Users}" FontSize="28" FontWeight="SemiBold"
                                           Margin="0,10,0,6"/>
                                <TextBlock Text="已配置的无头主机" FontSize="12"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="40" Height="40" CornerRadius="10"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ui:SymbolIcon Symbol="Server24" FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" MinHeight="128" Margin="8,0,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="活跃会话"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding ActiveSessions}" FontSize="28" FontWeight="SemiBold"
                                           Margin="0,10,0,6"/>
                                <TextBlock Text="当前正在运行" FontSize="12"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="40" Height="40" CornerRadius="10"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="20,18,20,12">
                            <TextBlock Text="已管理无头主机" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="启动、停止、编辑或移除已配置的无头主机。"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Profiles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MinHeight="140" MaxHeight="360"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="无头主机" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="目标服务器地址" Binding="{Binding BackendUrl}" Width="1.6*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="0.7*"/>
                                <DataGridTextColumn Header="进程 ID" Binding="{Binding ProcessId}" Width="0.55*"/>
                                <DataGridTextColumn Header="运行时间" Binding="{Binding Uptime}" Width="0.7*"/>
                                <DataGridTemplateColumn Header="操作" Width="480">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="查看" Tag="{Binding}" Padding="8,5"
                                                           Margin="0,0,6,0" Click="ViewLog_Click"/>
                                                <ui:Button Content="启动" Tag="{Binding}" Padding="8,5"
                                                           Appearance="Secondary" Margin="0,0,6,0"
                                                           Click="StartManager_Click"/>
                                                <ui:Button Content="停止" Tag="{Binding}" Padding="8,5"
                                                           Appearance="Secondary" Margin="0,0,6,0"
                                                           Click="StopManager_Click"/>
                                                <ui:Button Content="重启" Tag="{Binding}" Padding="8,5"
                                                           Appearance="Secondary" Margin="0,0,6,0"
                                                           Click="RestartManager_Click"/>
                                                <ui:Button Content="编辑" Tag="{Binding}" Padding="8,5"
                                                           Appearance="Secondary" Margin="0,0,6,0"
                                                           Click="EditManager_Click"/>
                                                <ui:Button Content="移除" Tag="{Binding}" Padding="8,5"
                                                           Appearance="Secondary"
                                                           Click="RemoveManager_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border x:Name="EditorOverlay" Grid.RowSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Width="560" Style="{StaticResource FluentCardStyle}" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="添加实例" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="配置一个 SPT 安装目录及其 Fika 无头配置。"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,5,0,18"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="实例名称" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                            <TextBlock Text="SPT 安装目录" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DirectoryInput"/>
                                <ui:Button Grid.Column="1" Content="浏览" Appearance="Secondary"
                                           Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="配置文件 ID / 令牌" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProfileInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="后端地址" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="BackendInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="窗口标题（可选）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TitleInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,18,0,0">
                            <CheckBox x:Name="AutoRestartInput" Content="自动重启" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ExtraLoggingInput" Content="额外文件日志"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditorError"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ui:Button Grid.Column="1" Content="取消" Appearance="Secondary"
                                   Margin="12,0,8,0" Click="CancelEditor_Click"/>
                        <ui:Button Grid.Column="2" Content="保存实例" Appearance="Primary"
                                   Click="SaveManager_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="LogOverlay" Grid.RowSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Style="{StaticResource FluentCardStyle}" Margin="40"
                    MaxWidth="1000" MaxHeight="700" MinHeight="480"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LogViewerTitle" Text="实时输出" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogViewerSubtitle"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="关闭" Appearance="Primary"
                                   VerticalAlignment="Center" Click="CloseLog_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
                        <TextBlock Text="来源"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="LogCategoryFilter" Width="130" SelectedIndex="0"
                                  SelectionChanged="LogFilter_SelectionChanged">
                            <ComboBoxItem Content="全部来源"/>
                            <ComboBoxItem Content="标准输出"/>
                            <ComboBoxItem Content="BepInEx 输出"/>
                        </ComboBox>
                        <TextBlock Text="级别"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="18,0,7,0"/>
                        <ComboBox x:Name="LogLevelFilter" Width="120" SelectedIndex="0"
                                  SelectionChanged="LogFilter_SelectionChanged">
                            <ComboBoxItem Content="全部级别"/>
                            <ComboBoxItem Content="消息"/>
                            <ComboBoxItem Content="信息"/>
                            <ComboBoxItem Content="警告"/>
                            <ComboBoxItem Content="错误"/>
                            <ComboBoxItem Content="调试"/>
                            <ComboBoxItem Content="致命"/>
                        </ComboBox>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" BorderBrush="#263248" BorderThickness="1">
                        <TextBox x:Name="LogOutputTextBox"
                                 Background="Transparent" Foreground="#D1FAE5" CaretBrush="White"
                                 BorderThickness="0" Padding="14" FontFamily="Cascadia Mono,Consolas"
                                 FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                               Text="输出仅在本次程序运行期间保存在内存中，每个实例最多保留 3000 条。"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Page>
