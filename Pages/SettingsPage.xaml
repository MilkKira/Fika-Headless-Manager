<Page x:Class="FikaHeadlessManager.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="设置"
      Loaded="SettingsPage_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,30" MaxWidth="880">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="个性化外观并查看程序信息。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="个性化" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,30,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="外观主题" Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="似白虹饮涧，玉龙下山，晴雪飞滩。"
                                       Style="{StaticResource SettingsCardDescriptionStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                        <RadioButton x:Name="LightThemeRadio" GroupName="AppTheme"
                                     Content="浅色" Tag="Light"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="DarkThemeRadio" GroupName="AppTheme"
                                     Content="深色" Tag="Dark" Margin="24,0,0,0"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <TextBlock Text="高级" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="18"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="高级设置" Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="控制与系统启动相关的行为。"
                                       Style="{StaticResource SettingsCardDescriptionStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="开机自启动" FontWeight="SemiBold"/>
                            <TextBlock Text="登录 Windows 时自动启动 Fika 无头管理器。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle"
                                         OnContent="开" OffContent="关"
                                         VerticalAlignment="Center"
                                         Checked="AutoStartToggle_Toggled"
                                         Unchecked="AutoStartToggle_Toggled"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自行唤起无头主机" FontWeight="SemiBold"/>
                            <TextBlock Text="启动后等待 5 秒，Ping通对应主机后自动启动全部无头主机。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="AutoWakeToggle"
                                         OnContent="开" OffContent="关"
                                         VerticalAlignment="Center"
                                         Checked="AutoWakeToggle_Toggled"
                                         Unchecked="AutoWakeToggle_Toggled"/>
                    </Grid>
                </Grid>
            </Border>
            
                        <TextBlock Text="程序信息" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="Info24" FontSize="18"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="关于" Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="满目山河空念远，落花风雨更伤春。不如怜取眼前人。"
                                       Style="{StaticResource SettingsCardDescriptionStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Top">
                            <Image Source="/FIKA_TOOLS_LOGO.ico" Width="34" Height="34" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fika 无头管理器" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="出门搔白首，若负平生志。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="版本" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" x:Name="VersionValueText" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="运行时"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeValueText" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Text="操作系统"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OperatingSystemValueText" Margin="0,8,0,0"/>
                            </Grid>
                            <TextBlock Text="MIT License · Copyright (c) 2026 Mochix2Milk And Lacyway"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <!-- END -->
        </StackPanel>
    </ScrollViewer>
</Page>
