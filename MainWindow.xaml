<Window x:Class="FikaHeadlessManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Fika 无头管理器"
        Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="☁" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Headless控制中心" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="无头管理器" Foreground="#8C96A8" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="工作区" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <Border Background="#283044" CornerRadius="7" Padding="11,10" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#A5B4FC" FontSize="17" Width="27"/>
                            <TextBlock Text="无头主机总览" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="＋ 添加Headless" Margin="0,12,0,0"
                            Click="AddManager_Click"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="全部启动" Margin="0,9,0,0"
                            Click="StartAll_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,30,0,0">
                    <TextBlock Text="已管理无头主机" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Profiles, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#64748B">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Fill" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Fill" Value="#F87171"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                        <Setter Property="Fill" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                                        <Setter Property="Fill" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="4" BorderBrush="#283044" BorderThickness="1" CornerRadius="8" Padding="11">
                    <StackPanel>
                        <TextBlock Text="控制台隐藏" Foreground="#A5B4FC" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="自动隐藏管理器和 BepInEx 控制台窗口。"
                                   Foreground="#8C96A8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="眉目山河空恋远，不如怜取眼前人" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2FF">
                            <TextBlock Text="●" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" FontWeight="SemiBold"/>
                            <TextBlock Text="Headless Control" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentGrid" Margin="28,24,28,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="运行概览" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="在一个窗口中监控并控制所有无头实例。"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="LastUpdatedText" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="20,0,0,2"/>
                    </Grid>

                    <Grid x:Name="KpiGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="UsersCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="无头主机数量" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Users, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="已配置的无头主机" Foreground="#0284C7" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#E0F2FE">
                                    <TextBlock Text="♟" Foreground="#0284C7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="SessionsCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="活跃会话" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ActiveSessions, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="当前正在运行" Foreground="#F59E0B" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#FEF3C7">
                                    <TextBlock Text="◉" Foreground="#D97706" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,18,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="已管理无头主机" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="启动、停止、编辑或移除已配置的无头主机。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="全部停止" Style="{StaticResource SecondaryButtonStyle}" Click="StopAll_Click"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Profiles, ElementName=Root}" MinHeight="120" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="无头主机" Binding="{Binding Name}" Width="1.2*"/>
                                    <DataGridTextColumn Header="目标服务器地址" Binding="{Binding BackendUrl}" Width="1.6*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="0.7*"/>
                                    <DataGridTextColumn Header="进程 ID" Binding="{Binding ProcessId}" Width="0.55*"/>
                                    <DataGridTextColumn Header="运行时间" Binding="{Binding Uptime}" Width="0.7*"/>
                                    <DataGridTemplateColumn Header="操作" Width="430">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="查看" Tag="{Binding}" Style="{StaticResource IconButtonStyle}" Click="ViewLog_Click" Margin="0,0,6,0"/>
                                                    <Button Content="启动" Tag="{Binding}" Style="{StaticResource IconButtonStyle}" Click="StartManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="停止" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="StopManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="重启" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="RestartManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="编辑" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="EditManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="移除" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveManager_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="EditorOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Width="540" Background="White" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="添加实例" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="配置一个 SPT 安装目录及其 Fika 无头配置。"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="实例名称" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                            <TextBlock Text="SPT 安装目录" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DirectoryInput"/>
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="配置文件 ID / 令牌" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProfileInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="后端地址" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="BackendInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="窗口标题（可选）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TitleInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,18,0,0">
                            <CheckBox x:Name="AutoRestartInput" Content="自动重启" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ExtraLoggingInput" Content="额外文件日志"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditorError" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,8,0" Click="CancelEditor_Click"/>
                        <Button Grid.Column="2" Content="保存实例" Style="{StaticResource PrimaryButtonStyle}" Click="SaveManager_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="LogOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="14" Padding="24" Margin="40"
                    MaxWidth="1000" MaxHeight="700" MinHeight="480"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LogViewerTitle" Text="实时输出" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogViewerSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" Click="CloseLog_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
                        <TextBlock Text="来源" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="LogCategoryFilter" Width="130" SelectedIndex="0" SelectionChanged="LogFilter_SelectionChanged">
                            <ComboBoxItem Content="全部来源"/>
                            <ComboBoxItem Content="标准输出"/>
                            <ComboBoxItem Content="BepInEx 输出"/>
                        </ComboBox>
                        <TextBlock Text="级别" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,7,0"/>
                        <ComboBox x:Name="LogLevelFilter" Width="120" SelectedIndex="0" SelectionChanged="LogFilter_SelectionChanged">
                            <ComboBoxItem Content="全部级别"/>
                            <ComboBoxItem Content="消息"/>
                            <ComboBoxItem Content="信息"/>
                            <ComboBoxItem Content="警告"/>
                            <ComboBoxItem Content="错误"/>
                            <ComboBoxItem Content="调试"/>
                            <ComboBoxItem Content="致命"/>
                        </ComboBox>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="9" BorderBrush="#263248" BorderThickness="1">
                        <TextBox x:Name="LogOutputTextBox"
                                 Background="Transparent" Foreground="#D1FAE5" CaretBrush="White"
                                 BorderThickness="0" Padding="15" FontFamily="Cascadia Mono,Consolas"
                                 FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="输出仅在本次程序运行期间保存在内存中，每个实例最多保留 3000 条。"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
