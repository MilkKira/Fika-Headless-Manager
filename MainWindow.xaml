<ui:FluentWindow x:Class="FikaHeadlessManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:FikaHeadlessManager.Pages"
        Title="Fika 无头管理器"
        Icon="/FIKA_TOOLS_LOGO.ico"
        Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/FIKA_TOOLS_LOGO.ico" Width="16" Height="16" Stretch="Uniform"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Fika 无头管理器" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="228">

            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Source="/FIKA_TOOLS_LOGO.ico" Width="22" Height="22" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Fika 无头管理器" FontWeight="SemiBold"/>
                        <TextBlock Text="Headless Control" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="无头主机总览"
                    TargetPageType="{x:Type pages:DashboardPage}"
                    NavigationCacheMode="Required"
                    Icon="{ui:SymbolIcon Symbol=Home24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置"
                    TargetPageType="{x:Type pages:SettingsPage}"
                    Icon="{ui:SymbolIcon Symbol=Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
