<Window x:Class="FikaHeadlessManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FikaHeadlessManager.Controls"
        x:Name="Root"
        Title="Fika Headless Manager"
        Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="FH" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Fika Control" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Headless Manager" Foreground="#8C96A8" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <Border Background="#283044" CornerRadius="7" Padding="11,10" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#A5B4FC" FontSize="17" Width="27"/>
                            <TextBlock Text="Overview" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="＋ Add manager" Margin="0,12,0,0"
                            Click="AddManager_Click"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Start all" Margin="0,9,0,0"
                            Click="StartAll_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,30,0,0">
                    <TextBlock Text="MANAGED INSTANCES" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Profiles, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#64748B">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Fill" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Fill" Value="#F87171"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                        <Setter Property="Fill" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="4" BorderBrush="#283044" BorderThickness="1" CornerRadius="8" Padding="11">
                    <StackPanel>
                        <TextBlock Text="Console protection" Foreground="#A5B4FC" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="Manager and BepInEx windows are hidden automatically."
                                   Foreground="#8C96A8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="330" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="34,8,10,8"/>
                        <TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="19"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,2" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search recent activity..." Foreground="#9CA3AF"
                                   Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2FF">
                            <TextBlock Text="●" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" FontWeight="SemiBold"/>
                            <TextBlock Text="Local control" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentGrid" Margin="28,24,28,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Analytics overview" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="Monitor and control every headless instance from one window."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="LastUpdatedText" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="20,0,0,2"/>
                    </Grid>

                    <Grid x:Name="KpiGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="RevenueCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Revenue" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Revenue, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="No revenue source connected" Foreground="#10B981" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#EEF2FF">
                                    <TextBlock Text="$" Foreground="{StaticResource PrimaryBrush}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="UsersCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Users" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Users, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="Configured profiles" Foreground="#0284C7" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#E0F2FE">
                                    <TextBlock Text="♟" Foreground="#0284C7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="ConversionCard" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Conversion rate" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ConversionRate, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="Successful starts" Foreground="#10B981" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#D1FAE5">
                                    <TextBlock Text="↗" Foreground="#059669" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="SessionsCard" Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0" MinHeight="128">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Active sessions" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ActiveSessions, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                    <TextBlock Text="Live right now" Foreground="#F59E0B" FontSize="11"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" CornerRadius="9" Background="#FEF3C7">
                                    <TextBlock Text="◉" Foreground="#D97706" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ChartsGrid" Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="TrendCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Session trends" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Active headless sessions during the last minute" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <controls:AreaChart Grid.Row="1" Values="{Binding TrendValues, ElementName=Root}" Margin="0,14,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="ComparisonCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Instance comparison" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Lifecycle outcomes this session" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <controls:BarChart Grid.Row="1" Values="{Binding ComparisonValues, ElementName=Root}"
                                                   Labels="{Binding ComparisonLabels, ElementName=Root}" Margin="0,14,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,18,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Managed instances" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Start, stop, edit, or remove configured headless clients." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Stop all" Style="{StaticResource SecondaryButtonStyle}" Click="StopAll_Click"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Profiles, ElementName=Root}" MinHeight="120" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Manager" Binding="{Binding Name}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Backend" Binding="{Binding BackendUrl}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.7*"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.55*"/>
                                    <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="0.7*"/>
                                    <DataGridTemplateColumn Header="Actions" Width="350">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="View" Tag="{Binding}" Style="{StaticResource IconButtonStyle}" Click="ViewLog_Click" Margin="0,0,6,0"/>
                                                    <Button Content="Start" Tag="{Binding}" Style="{StaticResource IconButtonStyle}" Click="StartManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="Stop" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="StopManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="Edit" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="EditManager_Click" Margin="0,0,6,0"/>
                                                    <Button Content="Remove" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveManager_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="8" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="20,18,20,14">
                                <TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Latest lifecycle and validation events across all managers." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ActivityView, ElementName=Root}" MinHeight="190" MaxHeight="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding DisplayTime}" Width="150"/>
                                    <DataGridTextColumn Header="Manager" Binding="{Binding ManagerName}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Event}" Width="2.4*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.7*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="EditorOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Width="540" Background="White" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="Add manager" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Configure one SPT installation and its Fika headless profile."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="Manager name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                            <TextBlock Text="SPT install directory" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DirectoryInput"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="Profile ID / token" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProfileInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="Backend URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="BackendInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                            <TextBlock Text="Window title (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TitleInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,18,0,0">
                            <CheckBox x:Name="AutoRestartInput" Content="Auto restart" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ExtraLoggingInput" Content="Extra file logging"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditorError" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,8,0" Click="CancelEditor_Click"/>
                        <Button Grid.Column="2" Content="Save manager" Style="{StaticResource PrimaryButtonStyle}" Click="SaveManager_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="LogOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="14" Padding="24" Margin="40"
                    MaxWidth="1000" MaxHeight="700" MinHeight="480"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LogViewerTitle" Text="Process output" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogViewerSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="12,0,8,0" VerticalAlignment="Center" Click="ClearLog_Click"/>
                        <Button Grid.Column="2" Content="Close" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" Click="CloseLog_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,16,0,10" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Sources: Manager lifecycle · stdout · stderr · BepInEx LogOutput.log · Headless.log"/>
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="9" BorderBrush="#263248" BorderThickness="1">
                        <TextBox x:Name="LogOutputTextBox"
                                 Background="Transparent" Foreground="#D1FAE5" CaretBrush="White"
                                 BorderThickness="0" Padding="15" FontFamily="Cascadia Mono,Consolas"
                                 FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Output is kept in memory for this application session and capped per manager."/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
